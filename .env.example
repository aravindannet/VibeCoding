# Frontend environment variables (Vite)
# For local development, these are optional (defaults to localhost:5001)
# For Netlify deployment, set these in Netlify dashboard under Site settings > Environment variables

# Backend API URL (production)
VITE_API_URL=https://your-backend-url.onrender.com/api

# Firebase configuration (if using Firebase Auth)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
